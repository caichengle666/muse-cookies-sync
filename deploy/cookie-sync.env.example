# Cookie Sync 环境变量模板
# ---------------------------------------------------------------
# 用途：给 systemd 的 EnvironmentFile= 使用（见 cookie-sync.service），
#       或直接 source 后用 shell 启动。注意：receiver.js 自身不解析 .env 文件。
# 用法：cp cookie-sync.env.example cookie-sync.env，改完让 unit 指向它即可。
# ---------------------------------------------------------------

# 监听端口（Nginx 反代到它）
PORT=8787

# 监听地址：放在 Nginx 后面时务必用 127.0.0.1，
# 这样 8787 不会被公网直接访问，只有本机反代能连
HOST=127.0.0.1

# 鉴权令牌：油猴面板里填同一个值
# 生成命令：openssl rand -hex 32
TOKEN=在这里粘贴openssl生成的长随机串

# 数据目录；不写时使用 server/data
# DATA_DIR=/var/lib/cookie-sync

# ---- 以下为可选调优项，不写就用默认值 ----

# 日志格式：text（默认，人读）或 json（便于采集）
LOG_FORMAT=text

# 每个站点保留的快照份数，默认 20；0 = 不限
MAX_SNAPSHOTS_PER_SITE=20

# 快照保留天数，默认 30；0 = 不按时间清理
RETENTION_DAYS=30

# 相同 Cookie 内容是否跳过重复落盘，默认 1 开启；设 0 关闭
DEDUP=1
