# Cookie Sync 环境变量模板
# ---------------------------------------------------------------
# 复制为 .env 后修改：cp cookie-sync.env.example .env
# .env 已在 .gitignore 中排除，不会被提交。
# ---------------------------------------------------------------

# 监听端口（Nginx 反代到它）
PORT=8787

# 监听地址：放在 Nginx 后面时务必用 127.0.0.1，
# 这样 8787 不会被公网直接访问，只有本机反代能连
HOST=127.0.0.1

# 鉴权令牌：油猴面板里填同一个值
# 生成命令：openssl rand -hex 32
TOKEN=在这里粘贴openssl生成的长随机串
