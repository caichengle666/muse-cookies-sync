# Cookie Sync —— systemd 服务单元
# ---------------------------------------------------------------
# 安装步骤（在服务器上执行）：
#   sudo cp cookie-sync.service /etc/systemd/system/cookie-sync.service
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now cookie-sync
#   sudo systemctl status cookie-sync
#   journalctl -u cookie-sync -f        # 看实时日志
#
# 部署前请把下面的路径 / 用户改成你自己的。
# 假设：代码放在 /opt/cookie-sync，运行用户为 cookiesync
# ---------------------------------------------------------------

[Unit]
Description=Cookie Sync receiver
Documentation=https://github.com/your/cookie-sync
After=network.target

[Service]
Type=simple
User=cookiesync
Group=cookiesync
WorkingDirectory=/opt/cookie-sync/server

# 从 .env 读取 PORT / HOST / TOKEN
EnvironmentFile=/opt/cookie-sync/server/.env

ExecStart=/usr/bin/node /opt/cookie-sync/server/receiver.js

# 崩溃自动重启
Restart=always
RestartSec=3

# ---- 安全加固 ----
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true

# ProtectSystem=strict 会让整个文件系统只读，
# 必须显式放开数据目录的写权限，否则落盘会失败
ReadWritePaths=/opt/cookie-sync/server/data

LimitNOFILE=4096

[Install]
WantedBy=multi-user.target
